# ==============================================================================
# DISCORD VOICE COUNTER BOT - CONFIGURATION
# ==============================================================================

# Discord Bot Token (Required from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Channel Restrictions & Logging (Optional - leave blank if not used)
REPORT_CHANNEL_ID=                      # Channel ID where automated monthly CSV reports are sent
STATS_CHANNEL_ID=                       # Text Channel ID to restrict /stats, /leaderboard, and /report commands
AFK_CHANNEL_ID=                         # AFK Voice Channel ID to auto-move deafened users

# Role Permissions (Optional)
# Comma-separated Role IDs or Role Names authorized to run /rolestats (Administrators always have access)
ROLESTATS_ALLOWED_ROLES=                # Example: 1473963046396494021,1474690818387349514

# Local Timezone (Standard IANA timezone name)
TIMEZONE=Asia/Dhaka

# SQLite Database Storage (Optional - defaults to voice_stats.db)
DB_FILE=voice_stats.db
